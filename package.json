{
  "name": "fume-rally",
  "version": "0.1.0",
  "private": true,
  "description": "A retro maze-rally arcade game for the browser, built with Three.js and TypeScript.",
  "author": "Wei-Te Wong",
  "license": "MIT",
  "homepage": "https://github.com/wongwt/FumeRally#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wongwt/FumeRally.git"
  },
  "bugs": {
    "url": "https://github.com/wongwt/FumeRally/issues"
  },
  "keywords": [
    "game",
    "arcade",
    "threejs",
    "three.js",
    "typescript",
    "retro",
    "maze",
    "racing",
    "browser-game"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
